# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
build/
dist/
*.spec

# Node / Web
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Secrets
.env
.env.local
*.pem
*.key

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch space (headless-browser renders, throwaway captures)
.scratch/

# Local backup copies of working files. public/ is served as-is, so a stray
# *.backup inside it would be published; the previous version of a file stays
# recoverable in git history instead.
*.backup

# The source drop for the hero art, the header logo and the Unreal Engine marks.
# It is kept on disk but is byte-for-byte what public/assets/ already serves, and
# the hero video alone is ~50 MB: versioning both copies would put ~100 MB of the
# same binary into history. What ships is public/assets/.
/assets/
